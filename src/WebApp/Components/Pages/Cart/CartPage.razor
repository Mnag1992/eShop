@page "/cart"
@inject NavigationManager Nav
@inject BasketState Basket
@inject IProductImageUrlProvider ProductImages
@attribute [StreamRendering]
@attribute [Authorize]

<PageTitle>Shopping Bag | AdventureWorks</PageTitle>
<SectionContent SectionName="page-header-title">Shopping bag</SectionContent>

<div class='cart'>
    @if (basketItems is null)
    {
        <p class="cart-empty">Loading...</p>
    }
    else if (basketItems.Count == 0)
    {
        <div class="cart-empty">
            <span class="cart-empty-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 16h24l-2 22H14z" />
                    <path d="M18 16v-2a6 6 0 0 1 12 0v2" />
                </svg>
            </span>
            <h2>Your shopping bag is empty</h2>
            <p>Browse the catalog and add the gear you love. Anything you add shows up here, ready to check out.</p>
            <a class="button button-primary" href="/">Start shopping</a>
        </div>
    }
    else
    {
        <div class='cart-items'>
            <div class='cart-item-header'>
                <div class='catalog-item-info'>Products</div>
                <div class='catalog-item-quantity'>Quantity</div>
                <div class='catalog-item-total'>Total</div>
            </div>
            @foreach (var item in basketItems)
            {
                var quantity = CurrentOrPendingQuantity(item.ProductId, item.Quantity);
                <div class="cart-item" @key="@item.Id">
                    <div class="catalog-item-info">
                        <img alt="@item.ProductName" src="@ProductImages.GetProductImageUrl(item.ProductId)" />
                        <div class="catalog-item-content">
                            <p class="name">@item.ProductName</p>
                            <p class="price">$@item.UnitPrice.ToPriceDisplay()</p>
                        </div>
                    </div>
                    <div class="catalog-item-quantity">
                        <form method="post" data-enhance class="cart-quantity">
                            <input type="hidden" name="_handler" value="update-cart" />
                            <AntiforgeryToken />
                            <input type="hidden" name="UpdateQuantityId" value="@item.ProductId" />
                            <button type="submit" class="cart-quantity-apply" name="UpdateQuantityValue" value="@quantity" data-cart-quantity-apply tabindex="-1" aria-hidden="true">Apply</button>

                            <div class="quantity-stepper">
                                <button type="submit" class="quantity-step" name="UpdateQuantityValue" value="@(quantity - 1)"
                                        aria-label="Decrease quantity of @item.ProductName" disabled="@(quantity <= 1)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /></svg>
                                </button>
                                <input class="quantity-value" type="number" min="1" inputmode="numeric"
                                       value="@quantity" aria-label="Quantity of @item.ProductName" data-cart-quantity-input />
                                <button type="submit" class="quantity-step" name="UpdateQuantityValue" value="@(quantity + 1)"
                                        aria-label="Increase quantity of @item.ProductName" disabled="@(quantity >= MaxQuantityPerItem)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                                </button>
                            </div>

                            @if (quantity >= MaxQuantityPerItem)
                            {
                                <span class="cart-limit-reached" data-cart-limit-reached>Limit reached</span>
                            }

                            <button type="submit" class="cart-remove" name="UpdateQuantityValue" value="0"
                                    aria-label="Remove @item.ProductName from your bag">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M4 7h16M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M6 7l1 13a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-13" />
                                </svg>
                                <span>Remove</span>
                            </button>
                        </form>
                    </div>
                    <div class="catalog-item-total">
                        $@((item.UnitPrice * quantity).ToPriceDisplay())
                    </div>
                </div>
            }
        </div>
       

        <div class="cart-summary">
            <div class="cart-summary-container">
                <div class="cart-summary-header">
                    <img role="presentation" src="icons/cart.svg" />
                    Your shopping bag
                    <span class="filter-badge">@TotalQuantity</span>
                </div>
                <div class="cart-summary-total">
                    <div>Total</div>
                    <div>$@TotalPrice?.ToPriceDisplay()</div>
                </div>
                <p class="cart-shipping-note" data-cart-shipping-note>
                    @if (TotalPrice >= FreeShippingThreshold)
                    {
                        <span>Free shipping unlocked</span>
                    }
                    else
                    {
                        <span>Add $@((FreeShippingThreshold - TotalPrice)?.ToPriceDisplay()) more to unlock free shipping</span>
                    }
                </p>
                <p class="cart-item-count" data-cart-item-count>@ItemCountLabel</p>
                <p class="cart-product-count" data-cart-product-count>@ProductCountLabel</p>
                <p class="cart-max-note" data-cart-max-note>Maximum @MaxQuantityPerItem per item</p>
                <p class="cart-average-price" data-cart-average-price>Average price per item: $@AveragePricePerItem?.ToPriceDisplay()</p>
                <p class="cart-priciest-item" data-cart-priciest-item>Priciest item: @PriciestItem?.ProductName ($@PriciestItem?.UnitPrice.ToPriceDisplay())</p>
                <a href="checkout" class="button button-primary">Check out</a>
                <a href="" class="cart-summary-link">
                    <img role="presentation" src="icons/arrow-left.svg" />
                    <p>Continue shopping</p>
                </a>
            </div>
        </div>
    }
</div>

<form @formname="update-cart" @onsubmit="@UpdateQuantityAsync"></form>

@code {
    private IReadOnlyCollection<BasketItem>? basketItems;

    [SupplyParameterFromForm]
    public int? UpdateQuantityId { get; set; }

    [SupplyParameterFromForm]
    public int? UpdateQuantityValue { get; set; }

    protected override async Task OnInitializedAsync()
    {
        basketItems = await Basket.GetBasketItemsAsync();
    }

    private decimal? TotalPrice => basketItems?.Sum(i => i.Quantity * i.UnitPrice);
    private decimal? TotalQuantity => basketItems?.Sum(i => i.Quantity);

    // Orders at or above this total ship for free; the bag shows how far away the shopper is.
    private const decimal FreeShippingThreshold = 300m;

    // "1 item in your bag" / "3 items in your bag" - singular only for exactly one item.
    private string ItemCountLabel => TotalQuantity == 1 ? "1 item in your bag" : $"{TotalQuantity} items in your bag";

    // Distinct products in the bag, independent of their quantities.
    private string ProductCountLabel => basketItems?.Count == 1 ? "1 product" : $"{basketItems?.Count ?? 0} products";

    // The product in the bag with the highest unit price (first one wins on a tie).
    private BasketItem? PriciestItem => basketItems?.OrderByDescending(i => i.UnitPrice).FirstOrDefault();

    // Total price divided by the number of units in the bag (not the number of distinct products).
    private decimal? AveragePricePerItem => TotalQuantity > 0 ? TotalPrice / TotalQuantity : null;

    // A single product can be bought at most this many times per order; larger quantities are capped.
    private const int MaxQuantityPerItem = 10;

    // While an update post is in process, we want to show the pending quantity, not the one
    // that is committed to the cart (otherwise the UI briefly shows the old data)
    private int CurrentOrPendingQuantity(int productId, int cartQuantity)
        => UpdateQuantityId.GetValueOrDefault(-1) == productId
        ? Math.Min(UpdateQuantityValue!.Value, MaxQuantityPerItem)
        : cartQuantity;

    private async Task UpdateQuantityAsync()
    {
        var id = UpdateQuantityId!.Value;
        var quantity = Math.Min(UpdateQuantityValue!.Value, MaxQuantityPerItem);
        await Basket.SetQuantityAsync(id, quantity);
        basketItems = await Basket.GetBasketItemsAsync();
    }
}
